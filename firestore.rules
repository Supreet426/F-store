rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is a Master Admin
    function isMasterAdmin() {
      return request.auth != null &&
             'email' in request.auth.token &&
             (request.auth.token.email.lower() == 'ranjanamishra1117@gmail.com' ||
              request.auth.token.email.lower() == 'supreet.mishr@gmail.com');
    }

    // Helper: Is Authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is Document Owner
    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Master Admin: Full Global Access across all collections & subcollections
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Merchants Collection - Protected Onboarding Gates & Isolated Profile Access
    match /merchants/{merchantId} {
      allow read: if isDocOwner(merchantId) || isMasterAdmin();
      allow create: if isDocOwner(merchantId) &&
                    (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
                    (!('isActive' in request.resource.data) || request.resource.data.isActive == false);
      allow update: if (isDocOwner(merchantId) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isApproved', 'registeredHubId', 'isActive', 'active', 'role'])) ||
                    isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // Legacy Sellers Collection - Isolated Profile Access
    match /sellers/{sellerId} {
      allow read: if isDocOwner(sellerId) || isMasterAdmin();
      allow create: if isDocOwner(sellerId);
      allow update: if isDocOwner(sellerId) || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // Users / User Profiles - Master Admin Protection Rule
    match /users/{userId} {
      allow read: if isDocOwner(userId) || isMasterAdmin();
      allow update: if (isDocOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'ADMIN')) || isMasterAdmin();
      allow delete: if isMasterAdmin() &&
                    userId != 'master_admin_ranjana' &&
                    userId != 'master_admin_supreet';
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isMasterAdmin();
      allow create, update: if isMasterAdmin();
      allow delete: if false;
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isDocOwner(customerId) || isMasterAdmin();
      allow write: if isDocOwner(customerId) || isMasterAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.merchantId == request.auth.uid || isMasterAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.merchantId == request.auth.uid || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    // Private Internal Master Products Collection
    // READ: Restricted to canonical merchant owner (merchantId == auth.uid) or Master Admin
    // DIRECT CLIENT WRITES (create/update/delete) ARE STRICTLY DENIED (if false)
    match /products/{productId} {
      allow read: if isAuthenticated() && (resource.data.merchantId == request.auth.uid || isMasterAdmin());
      allow create, update, delete: if false;
    }

    // Public Catalog Projection Collection
    // READ: Public for customer catalog app views ONLY
    // DIRECT CLIENT WRITES STRICTLY DENIED (Server-owned projection via Cloud Functions)
    match /public_products/{productId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Preorder Reservations Collection
    // READ: Customer can read their own reservation documents
    // DIRECT CLIENT WRITES STRICTLY DENIED (Server-owned via Cloud Functions)
    match /preorder_reservations/{reservationId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMasterAdmin());
      allow create, update, delete: if false;
    }

    // Dark Stores / Hubs Collection
    match /dark_stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isMasterAdmin();
    }

    // Riders Collection
    match /riders/{riderId} {
      allow read: if isDocOwner(riderId) || isMasterAdmin();
      allow write: if isDocOwner(riderId) || isMasterAdmin();
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read: if isDocOwner(staffId) || isMasterAdmin();
      allow write: if isDocOwner(staffId) || isMasterAdmin();
    }

    // Customer Leads & Profiles
    match /customer_leads/{leadId} {
      allow read, write: if isDocOwner(leadId) || isMasterAdmin();
    }

    match /profiles/{profileId} {
      allow read, write: if isDocOwner(profileId) || isMasterAdmin();
    }

    match /accounts/{accountId} {
      allow read, write: if isDocOwner(accountId) || isMasterAdmin();
    }

    // App Configuration: Everyone can read, only Admin can write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Service Requests (Callback Tickets)
    match /service_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMasterAdmin());
      allow create: if isAuthenticated();
      allow update: if isMasterAdmin();
    }

    // Live Support Chats
    match /support_chats/{chatId} {
      allow read, write: if isDocOwner(chatId) || isMasterAdmin();

      match /messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid || isMasterAdmin();
      }
    }
  }
}
