rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is a Master Admin
    function isMasterAdmin() {
      return request.auth != null &&
             'email' in request.auth.token &&
             (request.auth.token.email.lower() == 'ranjanamishra1117@gmail.com' ||
              request.auth.token.email.lower() == 'supreet.mishr@gmail.com');
    }

    // Helper: Is Authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is Verified & Active Merchant / Store Partner
    function isVerifiedMerchant() {
      return isAuthenticated() &&
             (isMasterAdmin() ||
              (exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.isApproved == true));
    }

    // Helper: Is Document Owner
    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Master Admin: Full Global Access across all collections & subcollections
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Sellers / Merchants
    match /sellers/{sellerId} {
      allow read: if isAuthenticated();
      allow create: if isDocOwner(sellerId);
      allow update: if isDocOwner(sellerId) || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // Users / User Profiles - Master Admin Protection Rule
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if (isDocOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'ADMIN')) || isMasterAdmin();
      allow delete: if isMasterAdmin() &&
                    userId != 'master_admin_ranjana' &&
                    userId != 'master_admin_supreet';
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isMasterAdmin();
      allow create, update: if isMasterAdmin();
      allow delete: if false; // Protect admin records from client deletion
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isDocOwner(customerId) || isMasterAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isVerifiedMerchant() || resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog view for customers
      allow create, update, delete: if isVerifiedMerchant();
    }

    // Dark Stores / Hubs Collection
    match /dark_stores/{storeId} {
      allow read: if true; // Public store locations view
      allow create, update, delete: if isVerifiedMerchant();
    }

    // Riders Collection
    match /riders/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isDocOwner(riderId) || isMasterAdmin();
    }

    // Staff & Support Staff Collection
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isDocOwner(staffId) || isMasterAdmin();
    }

    // Customer Leads & Profiles
    match /customer_leads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    match /profiles/{profileId} {
      allow read, write: if isAuthenticated();
    }

    match /accounts/{accountId} {
      allow read, write: if isAuthenticated();
    }

    // --- FLASH-O CARE: Support & Config Rules ---

    // App Configuration: Everyone can read, only Admin can write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Service Requests (Callback Tickets)
    match /service_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMasterAdmin());
      allow create: if isAuthenticated();
      allow update: if isMasterAdmin();
    }

    // Live Support Chats
    match /support_chats/{chatId} {
      // Users can only read/write their own chat document
      allow read, write: if isDocOwner(chatId) || isMasterAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid || isMasterAdmin();
      }
    }
  }
}
